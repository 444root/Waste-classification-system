# Used only by the local docker-compose.yml database.
POSTGRES_PASSWORD=change-me-for-local-docker

# Required by Dokploy when using an external PostgreSQL database.
DATABASE_URL=postgresql://user:password@database-host:5432/waste?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_DOMAIN=waste.example.com
API_DOMAIN=waste-api.example.com
FRONTEND_URL=http://localhost:3000
MAILEROO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Sortwise
